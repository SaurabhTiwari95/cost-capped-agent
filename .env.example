# Copy to .env (git-ignored) and adjust. Every setting is optional; these are the defaults.
# Your Claude API key is NOT read from this file: set ANTHROPIC_API_KEY in your shell (see README).

AGENT_ANSWER_MODEL=claude-opus-5-5
AGENT_SUMMARY_MODEL=claude-haiku-5-5
AGENT_ANSWER_EFFORT=medium
AGENT_SUMMARY_EFFORT=low

# Spend caps in USD: per question (or per --summarize run), and per UTC day across all runs
AGENT_RUN_CAP_USD=0.25
AGENT_DAY_CAP_USD=2.00

AGENT_MAX_STEPS=10
AGENT_MAX_OUTPUT_TOKENS=8000
AGENT_DB_PATH=data/agent.db
